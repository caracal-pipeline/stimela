#!/usr/bin/env python3
"""A stand-in for slurm's srun, used by test_podman.py: logs the invocation to $FAKE_PODMAN_DIR/srun.jsonl,
skips over srun options (-J NAME, --option VALUE), and runs the remaining command locally."""

import json
import os
import subprocess
import sys

args = sys.argv[1:]
with open(os.path.join(os.environ["FAKE_PODMAN_DIR"], "srun.jsonl"), "a") as log:
    log.write(json.dumps(args) + "\n")
while args and args[0].startswith("-"):
    args = args[2:]
sys.exit(subprocess.call(args))
